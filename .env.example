# AI DIGITAL SINAI environment template. Never put real credentials here.
NODE_ENV=development
PORT=3000
SQLITE_PATH=.data/ai-digital-sinai.sqlite
# Production requires PostgreSQL; do not use SQLite in production.
DATABASE_URL=
PG_SSL=require
PG_POOL_MIN=2
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=15000
COMMAND_CONTEXT_SECRET=replace-with-a-secret-manager-value
JWT_SECRET=replace-with-a-secret-manager-value
PAYMENT_WEBHOOK_SECRET=replace-with-a-provider-secret
PAYMENT_PROVIDER_API_URL=
PAYMENT_PROVIDER_API_KEY=
AI_PROVIDER_API_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_NAME=
EMAIL_PROVIDER_API_KEY=
NOTIFICATION_PROVIDER_API_URL=
NOTIFICATION_PROVIDER_API_KEY=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=
EMBEDDING_PROVIDER_API_URL=
EMBEDDING_PROVIDER_API_KEY=
WORKER_QUEUE=default
WORKER_MAX_ATTEMPTS=3
SECRETS_MANAGER_URL=
CORS_ORIGINS=http://localhost:3000
